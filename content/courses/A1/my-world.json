  "project": {
    "title": "My World Profile",
    "description": "Create a personal profile and introduce the people who are important to you. The project grows lesson by lesson.",
    "deliverable": "A personal profile with an identity card and a family tree, presented in simple English.",
    "successCriteria": [
      "I can introduce myself and give basic personal information.",
      "I can name countries and nationalities.",
      "I can use be in affirmative, negative and question forms.",
      "I can talk about family members and relationships.",
      "I can use plural nouns, possessive adjectives and demonstratives.",
      "I can present my family tree in simple English."
    ]
  },
  "objectives": [
    "Introduce yourself and ask for basic personal information.",
    "Name family members and describe family relationships.",
    "Use regular and irregular plural nouns.",
    "Use possessive adjectives and this, that, these and those.",
    "Create and present a personal profile and family tree."
  ],
  "skills": [
    "Vocabulary",
    "Grammar",
    "Reading",
    "Listening",
    "Writing",
    "Speaking"
  ],
  "vocabulary": [
