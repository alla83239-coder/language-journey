  "subtitle": "All About Me",
  "version": "1.3.4",
  "status": "Published",
  "language": "en",
  "interfaceLanguage": "ru",
  "estimatedMinutes": 120,
  "project": {
    "title": "My World Profile",
    "description": "Create a personal profile and introduce the people who are important to you. The project grows lesson by lesson.",
    "deliverable": "A personal profile with an identity card and a family tree, presented in simple English.",
    "successCriteria": [
      "I can introduce myself and give basic personal information.",
      "I can name countries and nationalities.",
      "I can use be in affirmative, negative and question forms.",
      "I can talk about family members and relationships.",
      "I can use plural nouns, possessive adjectives and demonstratives.",
      "I can present my family tree in simple English."
    ]
  },
  "objectives": [
    "Introduce yourself and ask for basic personal information.",
    "Name family members and describe family relationships.",
    "Use regular and irregular plural nouns.",
    "Use possessive adjectives and this, that, these and those.",
    "Create and present a personal profile and family tree."
  ],
  "skills": [
    "Vocabulary",
    "Grammar",
    "Reading",
    "Listening",
    "Writing",
    "Speaking"
  ],
  "vocabulary": [
    {
      "term": "name",
      "meaning": "имя",
      "example": "My name is Alex."
    },
    {
      "term": "age",
      "meaning": "возраст",
      "example": "I'm 14 years old."
    },
    {
      "term": "country",
      "meaning": "страна",
      "example": "I'm from Italy."
    },
    {
      "term": "nationality",
      "meaning": "национальность",
      "example": "I'm Italian."
    },
    {
      "term": "spell",
      "meaning": "называть по буквам",
      "example": "How do you spell your name?"
    },
    {
      "term": "family",
      "meaning": "семья",
      "example": "This is my family."
    },
    {
      "term": "friend",
      "meaning": "друг",
      "example": "They're my friends."
    }
  ],
  "grammar": [
    {
      "title": "Verb be",
      "rule": "I am / I'm · He/She/It is / He's/She's/It's · You/We/They are / You're/We're/They're. Negative: I'm not · isn't · aren't. Questions: Am I? Is he/she/it? Are you/we/they?",
      "examples": [
        "I'm Marie. My name's Mateo.",
        "We're at the same school.",
        "They aren't in the same class.",
        "Are you from England? No, I'm not."
      ]
    },
    {
      "title": "Possessive adjectives",
      "rule": "I → my · you → your · he → his · she → her · it → its · we → our · they → their",
      "examples": [
        "This is my family.",
        "It's her favourite band.",
        "They're with their friend.",
        "We're with our dog."
      ]
    },
    {
      "title": "Demonstratives",
      "rule": "Near: this (singular), these (plural). Far: that (singular), those (plural).",
      "examples": [
        "This is my photo.",
        "That is my house.",
        "These are my cousins.",
        "Those are my brothers."
      ]
    }
  ],
