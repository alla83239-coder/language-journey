      "example": "This is my family."
    },
    {
      "term": "friend",
      "meaning": "друг",
      "example": "They're my friends."
    }
  ],
  "grammar": [
    {
      "title": "Verb be",
      "rule": "I am / I'm · He/She/It is / He's/She's/It's · You/We/They are / You're/We're/They're. Negative: I'm not · isn't · aren't. Questions: Am I? Is he/she/it? Are you/we/they?",
      "examples": [
        "I'm Marie. My name's Mateo.",
        "We're at the same school.",
        "They aren't in the same class.",
        "Are you from England? No, I'm not."
      ]
    },
    {
      "title": "Possessive adjectives",
      "rule": "I → my · you → your · he → his · she → her · it → its · we → our · they → their",
      "examples": [
        "This is my family.",
        "It's her favourite band.",
        "They're with their friend.",
        "We're with our dog."
      ]
    },
    {
      "title": "Demonstratives",
      "rule": "Near: this (singular), these (plural). Far: that (singular), those (plural).",
      "examples": [
        "This is my photo.",
        "That is my house.",
        "These are my cousins.",
        "Those are my brothers."
      ]
    }
  ],
